account_id = "0123456789abcdef0123456789abcdef"
hostname   = "ghcr-badge.egpl.dev"

# The zone (egpl.dev) and its DNS records live in the iac repository; only the
# hostname's own record is created here, by the Workers custom domain.
# zone_name = "egpl.dev"
# zone_id   = "fedcba9876543210fedcba9876543210"

# Staged rollout while DNS still points at Render: attach nothing to the
# hostname and try the Worker on *.workers.dev. Flip both once the CNAME is gone.
enable_custom_domain = true
enable_workers_dev   = false

# app_version and container_image are passed on the command line by mise
# (from the latest git tag) and need not be set here.

# Sizing. lite is 1/16 vCPU, 256 MiB, 2 GB disk — plenty for FastAPI + uvicorn.
container_instance_type = "lite"
container_max_instances = 1
container_sleep_after   = "10m"

# Cache: how stale a badge may be at the edge, and in the client
cache_ttl_seconds   = 600
browser_ttl_seconds = 300

# Cache misses per minute per IP (hits are free and uncounted)
rate_limit_miss = 60

# Zone-level ceiling, counted per 10 s. Only one ruleset per phase fits on a
# zone: leave this off when another deployment on the same zone already has one
# (egpl.dev's http_ratelimit phase belongs to dbpedia-japanese-mirror).
enable_zone_rules                  = false
zone_rate_limit_requests           = 100
zone_rate_limit_mitigation_timeout = 10
